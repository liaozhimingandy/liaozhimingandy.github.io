# =============================================================================
# AP（Also Apps）后端环境变量模板
# 用法：cp .env.example .env，只填下方「必需」项。.env 已被 gitignore 排除。
#
# 原则：只写区别于 backend/app/config.py 默认值的配置。把代码默认值再抄一份到
# env 里，改动时容易漏掉其中一处，正是配置漂移的根源。
# 密码含 '@' 时用 AP_PG_PASSWORD 单独传，容器会自动做 URL 编码；
# 切勿把裸密码拼进 AP_DATABASE_URL（会被误当作 host 分隔符）。
# =============================================================================

# ---- 必需：PostgreSQL 连接（外部托管，6432 通常是 PgBouncer 端口）----
AP_STORE=postgres
AP_PG_HOST=<填数据库IP或域名>
AP_PG_PORT=6432
AP_PG_NAME=alsoapp
AP_PG_USER=alsoapp
AP_PG_PASSWORD=<填真实口令>
# 云库要求 SSL 时再加 AP_PG_SSLMODE=require（默认空，不写即可）

# ---- 必需：CORS 放行前端 origin（不是后端域名，不带路径或尾斜杠）----
AP_CORS_ORIGINS=https://www.alsoapp.com

# ---- 容器运行 ----
AP_HOST=0.0.0.0
AP_BIND_ADDR=127.0.0.1

# ---- 门户管理员白名单：Logto sub（逗号分隔）；留空 = 所有管理接口 fail-closed ----
PORTAL_ADMIN_SUBS=<填管理员 Logto sub>

# ---- 镜像部署 ----
AP_IMAGE=ghcr.io/liaozhimingandy/fastapi-ap:latest

# -----------------------------------------------------------------------------
# 以下项在 backend/app/config.py 已有同值默认，只有需要改变行为时才显式配置：
#   AP_AUTH_MODE=passthrough        # 生产切 logto 时同时填 LOGTO_ISSUER / AUDIENCE / JWKS_URL
#   AP_DEV_AUTH_HEADER=X-User-Sub
#   AP_PASSTHROUGH_DEFAULT_SUB=anonymous
#   AP_PORT=8080
#   AP_PUBLIC_PATH=/ap/             # 仅后端托管 dist 时用；本站为根路径部署，
#                                   # 若改为后端托管 dist 必须显式设 AP_PUBLIC_PATH=/
#   AP_MAX_VALUE_BYTES=524288 / AP_MAX_KEYS=200
#   AP_PG_PREPARE_THRESHOLD=off / AP_PG_POOL_MAX=8 / AP_PG_CONNECT_TIMEOUT=10
#   AP_DATABASE_URL=                # 高级：完整 DSN，留空则由上面的分散变量组装
# 前端 Logto appId 是公开默认值 plu65e7c0nypndqg7s4hp，无需在后端配置。
# -----------------------------------------------------------------------------
