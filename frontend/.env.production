# 生产构建环境变量（vite build 自动加载 .env.production）
#
# 设计目标：部署工作流保持通用——不在 CI 里内联任何 VITE_* 具体值，
# 所有生产配置集中在本文件，改地址只改这里并提交即可。
#
# 安全说明：VITE_* 会在构建期内联进浏览器产物，只能放公开值。
#   - Logto endpoint / appId 是 PKCE 公共客户端标识，设计上就暴露在前端，非密钥；
#   - 真正的密钥（Logto appSecret、数据库口令等）绝不进前端，只在后端环境变量里。
#   - VITE_DEV_USER_SUB 仅本地联调用，生产构建绝不设置（见 .env.development）。

# 后端 API 根（跨源部署；后端托管 dist 的同源形态留空即可，走相对路径 /v1）
VITE_API_BASE_URL=https://api.alsoapp.com

# Logto 租户（公开客户端配置；代码内亦有同值默认，这里显式声明便于集中维护）
VITE_LOGTO_ENDPOINT=https://account.alsoapp.com
VITE_LOGTO_APP_ID=plu65e7c0nypndqg7s4hp

# 登录回调 / 登出回跳必须落在访问域根路径（同 origin，不带 fragment #）
# 原因：OAuth redirect_uri 不允许 fragment；跨 origin（如 Pages 源站）会 301
# 导致 sessionStorage 里的「云端恢复意图」丢失，且该 URI 未在 Logto 登记会 400。
VITE_LOGTO_REDIRECT_URI=https://www.alsoapp.com/
VITE_LOGTO_POST_LOGOUT_REDIRECT_URI=https://www.alsoapp.com/
